{
  // The Discord webhook URL is NOT here. It is a secret, set once with:
  //   npx wrangler secret put DISCORD_WEBHOOK
  // Secrets live in Cloudflare, not in this file, so this directory is safe to commit.
  //
  // The worker name becomes the first DNS label of the deployed URL:
  //   combat-tracker-relay.<your-account-subdomain>.workers.dev
  "name": "combat-tracker-relay",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",

  // One instance, reached by a fixed name, holds the per-minute send budget and
  // the overflow. SQLite backend because that is the one the free plan supports.
  "durable_objects": {
    "bindings": [{ "name": "AGGREGATOR", "class_name": "AlertAggregator" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AlertAggregator"] }
  ],

  // Two layers, both far above anything the mod can produce. It sends at most one
  // message every 15 seconds (4/min), so a real client never approaches either.
  // The burst limiter catches a flood arriving all at once; the sustained one
  // catches a slow drip that would still drain the daily request quota.
  "ratelimits": [
    { "name": "BURST", "namespace_id": "1001", "simple": { "limit": 3, "period": 10 } },
    { "name": "SUSTAINED", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  // Logs for the relay, so a failing forward is diagnosable with `wrangler tail`
  // rather than invisible. Sampling at 1 because the traffic here is tiny.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
