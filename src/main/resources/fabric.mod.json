{
	"schemaVersion": 1,
	"id": "combat_tracker",
	"version": "${version}",
	"name": "Combat Tracker",
	"description": "Client-side stat tracker that detects and records jump-reset timing in PvP. Purely observational - it never modifies game physics or mechanics.",
	"authors": [
		"builtdoor"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/combat_tracker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"combat_tracker.CombatTrackerClient"
		],
		"modmenu": [
			"combat_tracker.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "combat_tracker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
